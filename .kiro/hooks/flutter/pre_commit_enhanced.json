{
  "name": "Enhanced Pre-Commit Hook",
  "description": "Comprehensive pre-commit checks for Flutter projects",
  "trigger": "pre-commit",
  "actions": [
    {
      "type": "shell",
      "command": "echo '🔍 Running pre-commit quality checks...'"
    },
    {
      "type": "shell",
      "command": ".kiro/hooks/flutter/comprehensive_analysis.sh",
      "continueOnError": false
    },
    {
      "type": "shell",
      "command": ".kiro/hooks/flutter/dependency_manager.sh audit",
      "continueOnError": true
    },
    {
      "type": "shell",
      "command": "flutter test --reporter=compact",
      "continueOnError": false
    },
    {
      "type": "shell",
      "command": "echo '✅ Pre-commit checks completed successfully!'"
    }
  ],
  "settings": {
    "enabled": true,
    "blocking": true,
    "timeout": 120000
  }
}
