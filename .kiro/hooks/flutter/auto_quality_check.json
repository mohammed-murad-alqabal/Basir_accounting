{
  "name": "Flutter Auto Quality Check",
  "description": "Runs comprehensive Flutter quality checks automatically",
  "trigger": "on-save",
  "conditions": {
    "filePattern": "lib/**/*.dart"
  },
  "actions": [
    {
      "type": "shell",
      "command": ".kiro/hooks/flutter/comprehensive_analysis.sh",
      "async": true,
      "timeout": 30000
    }
  ],
  "settings": {
    "enabled": true,
    "runInBackground": true,
    "showNotifications": true
  }
}
