{
  "name": "Adaptive Testing Hook",
  "description": "Intelligently determines which tests to run based on code changes and historical patterns",
  "version": "1.0.0",
  "type": "smart",
  "triggers": ["on-save", "on-commit", "on-pr-create"],
  "conditions": {
    "file_patterns": ["**/*.dart"],
    "exclude_patterns": ["**/*.g.dart", "**/*.freezed.dart", "**/test/**"]
  },
  "intelligence": {
    "enabled": true,
    "algorithms": [
      "impact_analysis",
      "dependency_mapping",
      "historical_failure_prediction"
    ],
    "learning_data": ".kiro/hooks/smart/data/test_patterns.json",
    "adaptation_threshold": 0.75
  },
  "analysis": {
    "code_impact": {
      "enabled": true,
      "analyze_dependencies": true,
      "track_method_changes": true,
      "monitor_imports": true
    },
    "test_selection": {
      "strategy": "intelligent",
      "max_tests": 50,
      "priority_weights": {
        "direct_impact": 0.4,
        "historical_failures": 0.3,
        "code_coverage": 0.2,
        "execution_time": 0.1
      }
    }
  },
  "actions": [
    {
      "type": "analyze_impact",
      "command": "python3",
      "args": [
        ".kiro/hooks/smart/scripts/impact_analyzer.py",
        "--changed-files",
        "{changed_files}",
        "--project-root",
        "{project_root}",
        "--output",
        "{temp_dir}/impact_analysis.json"
      ]
    },
    {
      "type": "select_tests",
      "command": "python3",
      "args": [
        ".kiro/hooks/smart/scripts/test_selector.py",
        "--impact-analysis",
        "{temp_dir}/impact_analysis.json",
        "--test-history",
        ".kiro/hooks/smart/data/test_history.json",
        "--output",
        "{temp_dir}/selected_tests.json"
      ]
    },
    {
      "type": "run_tests",
      "command": "flutter",
      "args": [
        "test",
        "--reporter=json",
        "--coverage",
        "{selected_test_files}"
      ],
      "capture_output": true
    },
    {
      "type": "update_learning",
      "command": "python3",
      "args": [
        ".kiro/hooks/smart/scripts/learning_updater.py",
        "--test-results",
        "{test_results}",
        "--selected-tests",
        "{temp_dir}/selected_tests.json",
        "--update-model",
        "true"
      ]
    }
  ],
  "optimization": {
    "parallel_execution": true,
    "cache_results": true,
    "skip_unchanged": true,
    "time_budget": "5m"
  },
  "reporting": {
    "enabled": true,
    "metrics": [
      "tests_selected",
      "tests_executed",
      "execution_time",
      "selection_accuracy",
      "time_saved"
    ],
    "output_file": ".kiro/hooks/smart/reports/adaptive_testing_{timestamp}.json"
  }
}
