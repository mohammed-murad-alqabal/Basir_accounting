  "query": "\n            SELECT id, base_currency, target_currency, rate, effective_date, source\n            FROM exchange_rates\n            WHERE ($1::text IS NULL OR base_currency = $1)\n              AND ($2::text IS NULL OR target_currency = $2)\n            ORDER BY effective_date DESC\n            ",
