{
  "name": "Adaptive Testing Intelligence",
  "description": "ML-enhanced testing that adapts based on code changes and historical patterns",
  "version": "1.0.0",
  "author": "فريق وكلاء تطوير مشروع بصير",
  "created": "2025-12-15",
  "type": "smart",
  "category": "testing",
  "triggers": [
    {
      "event": "code_commit",
      "patterns": ["lib/**/*.dart"],
      "conditions": {
        "has_tests": "check_existing_tests",
        "complexity_change": "analyze_complexity_delta"
      }
    }
  ],
  "ai_configuration": {
    "model": "code_analysis_model",
    "learning_from_failures": true,
    "test_pattern_recognition": true,
    "risk_assessment": true
  },
  "intelligence_features": {
    "test_prioritization": {
      "enabled": true,
      "algorithm": "risk_based_prioritization",
      "factors": [
        "code_complexity",
        "change_frequency",
        "bug_history",
        "business_criticality"
      ]
    },
    "test_generation": {
      "enabled": true,
      "auto_generate_missing_tests": true,
      "test_quality_threshold": 0.8
    },
    "failure_prediction": {
      "enabled": true,
      "prediction_model": "test_failure_predictor",
      "confidence_threshold": 0.7
    }
  },
  "actions": [
    {
      "type": "analyze_changes",
      "description": "Analyze code changes and assess testing needs",
      "command": "python3 .kiro/hooks/smart/scripts/test_analyzer.py",
      "args": ["--changes", "{changed_files}", "--analyze", "testing_needs"],
      "output_format": "json"
    },
    {
      "type": "prioritize_tests",
      "description": "Intelligently prioritize which tests to run",
      "command": "python3 .kiro/hooks/smart/scripts/test_prioritizer.py",
      "args": ["--changes", "{changed_files}", "--history", "{test_history}"],
      "condition": "has_existing_tests == true"
    },
    {
      "type": "run_smart_tests",
      "description": "Run prioritized tests based on AI analysis",
      "command": "flutter test",
      "args": ["{prioritized_test_files}", "--reporter=compact"],
      "timeout": 300
    },
    {
      "type": "generate_missing_tests",
      "description": "Generate tests for uncovered code",
      "condition": "coverage_gap_detected == true",
      "command": "python3 .kiro/hooks/smart/scripts/test_generator.py",
      "args": ["--file", "{file_path}", "--coverage-gap", "{coverage_analysis}"]
    },
    {
      "type": "learn_from_results",
      "description": "Update ML model based on test results",
      "command": "python3 .kiro/hooks/smart/scripts/learning_engine.py",
      "args": ["--results", "{test_results}", "--update-model"],
      "run_async": true
    }
  ],
  "learning_metrics": {
    "test_effectiveness": "measure test failure prediction accuracy",
    "coverage_improvement": "track coverage increases from generated tests",
    "time_savings": "measure reduction in test execution time",
    "bug_prevention": "track bugs prevented by predictive testing"
  },
  "adaptive_behavior": {
    "test_selection_learning": {
      "enabled": true,
      "algorithm": "reinforcement_learning",
      "reward_function": "test_effectiveness_score"
    },
    "pattern_recognition": {
      "enabled": true,
      "patterns": [
        "common_bug_locations",
        "test_failure_patterns",
        "code_quality_indicators"
      ]
    },
    "continuous_improvement": {
      "model_retraining": "weekly",
      "performance_evaluation": "daily",
      "feedback_integration": "real_time"
    }
  }
}
