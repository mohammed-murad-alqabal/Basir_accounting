# بصير MVP - Environment Variables Template
# نسخ هذا الملف إلى .env وتعبئة القيم الفعلية

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=your_database_url_here
DATABASE_NAME=basser_mvp
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ============================================
# API Keys & Secrets
# ============================================
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
JWT_SECRET=your_jwt_secret_here

# ============================================
# Firebase Configuration (if used)
# ============================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# ============================================
# Storage Configuration
# ============================================
STORAGE_BUCKET=your_storage_bucket
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# ============================================
# Email Configuration (if used)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# ============================================
# Payment Gateway (if used)
# ============================================
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_SECRET_KEY=your_payment_secret_key

# ============================================
# Development Settings
# ============================================
DEBUG_MODE=true
LOG_LEVEL=debug
ENVIRONMENT=development

# ============================================
# Security Settings
# ============================================
ENCRYPTION_KEY=your_encryption_key_here
SALT_ROUNDS=10

# ============================================
# External Services
# ============================================
ANALYTICS_ID=your_analytics_id
SENTRY_DSN=your_sentry_dsn

# ============================================
# Notes
# ============================================
# - Never commit .env file to version control
# - Keep this .env.example updated with new variables
# - Use strong, unique values for production
# - Rotate secrets regularly
