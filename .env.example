# بصير MVP - Environment Variables Template
# نسخ هذا الملف إلى .env وتعبئة القيم الفعلية

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=your_database_url_here
DATABASE_NAME=basir_mvp
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ============================================
# API Keys & Secrets
# ============================================
API_KEY=redacted
API_SECRET=redacted
JWT_SECRET=redacted

# ============================================
# Firebase Configuration (if used)
# ============================================
FIREBASE_API_KEY=redacted
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# ============================================
# Storage Configuration
# ============================================
STORAGE_BUCKET=your_storage_bucket
STORAGE_ACCESS_KEY=redacted
STORAGE_SECRET_KEY=redacted

# ============================================
# Email Configuration (if used)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=redacted

# ============================================
# Payment Gateway (if used)
# ============================================
PAYMENT_API_KEY=redacted
PAYMENT_SECRET_KEY=redacted

# ============================================
# Development Settings
# ============================================
DEBUG_MODE=true
LOG_LEVEL=debug
ENVIRONMENT=development

# ============================================
# Security Settings
# ============================================
ENCRYPTION_KEY=your_encryption_key_here
SALT_ROUNDS=10

# ============================================
# External Services
# ============================================
ANALYTICS_ID=your_analytics_id
SENTRY_DSN=your_sentry_dsn

# ============================================
# Design & Collaboration Tools
# ============================================
# Figma Integration
FIGMA_ACCESS_TOKEN=redacted
FIGMA_TEAM_ID=your_figma_team_id_here
FIGMA_PROJECT_ID=your_figma_project_id_here

# ============================================
# Notes
# ============================================
# - Never commit .env file to version control
# - Keep this .env.example updated with new variables
# - Use strong, unique values for production
# - Rotate secrets regularly
