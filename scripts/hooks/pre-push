#!/bin/bash
# Pre-push Hook - Error Tracking System
# المشروع: بصير MVP
# المؤلف: فريق وكلاء تطوير مشروع بصير
# التاريخ: 3 ديسمبر 2025

set -e

# الألوان
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# قراءة التكوين
CONFIG_FILE=".kiro/config/error_tracking.yml"
ENABLED=$(grep -A 3 "pre_push:" "$CONFIG_FILE" | grep "enabled:" | awk '{print $2}')
RUN_TESTS=$(grep -A 3 "pre_push:" "$CONFIG_FILE" | grep "run_tests:" | awk '{print $2}')
SCAN_SECRETS=$(grep -A 3 "pre_push:" "$CONFIG_FILE" | grep "scan_secrets:" | awk '{print $2}')

# التحقق من تفعيل الـ hook
if [ "$ENABLED" != "true" ]; then
    echo -e "${YELLOW}⚠️  Pre-push hook معطل في التكوين${NC}"
    exit 0
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}🚀 تشغيل Pre-push Hook...${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

START_TIME=$(date +%s)

# ===== 1. تشغيل الاختبارات =====
if [ "$RUN_TESTS" = "true" ]; then
    echo -e "${BLUE}🧪 تشغيل جميع الاختبارات...${NC}"
    echo ""
    
    # تشغيل flutter test
    if flutter test --no-pub 2>&1 | tee /tmp/test_output.log; then
        echo ""
        echo -e "${GREEN}✅ جميع الاختبارات نجحت${NC}"
        
        # حفظ نتائج الاختبارات
        TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
        cp /tmp/test_output.log "logs/flutter_test_${TIMESTAMP}.log"
    else
        echo ""
        echo -e "${RED}❌ فشلت بعض الاختبارات!${NC}"
        echo ""
        
        # حفظ نتائج الاختبارات الفاشلة
        TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
        cp /tmp/test_output.log "logs/flutter_test_failed_${TIMESTAMP}.log"
        
        # عرض الاختبارات الفاشلة
        echo -e "${RED}الاختبارات الفاشلة:${NC}"
        grep -A 5 "FAILED" /tmp/test_output.log || grep -A 5 "Error" /tmp/test_output.log || true
        echo ""
        echo -e "${YELLOW}📄 تم حفظ التفاصيل في: logs/flutter_test_failed_${TIMESTAMP}.log${NC}"
        echo ""
        echo -e "${RED}❌ يرجى إصلاح الاختبارات الفاشلة قبل الـ push${NC}"
        exit 1
    fi
    
    echo ""
fi

# ===== 2. فحص الأسرار المكشوفة =====
if [ "$SCAN_SECRETS" = "true" ]; then
    echo -e "${BLUE}🔐 فحص الأسرار المكشوفة...${NC}"
    echo ""
    
    # قراءة أنماط الأسرار من التكوين
    SECRET_PATTERNS=(
        "api[_-]?key"
        "password"
        "token"
        "secret"
        "bearer"
        "auth"
        "private[_-]?key"
        "access[_-]?token"
    )
    
    # الحصول على الملفات المعدلة
    MODIFIED_FILES=$(git diff --name-only HEAD @{u} 2>/dev/null || git diff --name-only --cached)
    
    if [ -z "$MODIFIED_FILES" ]; then
        echo -e "${YELLOW}ℹ️  لا توجد ملفات معدلة للفحص${NC}"
    else
        SECRETS_FOUND=false
        
        for file in $MODIFIED_FILES; do
            if [ -f "$file" ]; then
                for pattern in "${SECRET_PATTERNS[@]}"; do
                    # البحث عن الأنماط (case-insensitive)
                    if grep -iHn "$pattern" "$file" 2>/dev/null | grep -v "# SECRET_PATTERNS" | grep -v "secret_patterns:" > /tmp/secret_matches.txt; then
                        if [ -s /tmp/secret_matches.txt ]; then
                            SECRETS_FOUND=true
                            echo -e "${RED}⚠️  تم اكتشاف نمط سر محتمل في: $file${NC}"
                            echo -e "${YELLOW}النمط: $pattern${NC}"
                            head -5 /tmp/secret_matches.txt
                            echo ""
                        fi
                    fi
                done
            fi
        done
        
        if [ "$SECRETS_FOUND" = true ]; then
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo -e "${RED}❌ تم اكتشاف أسرار محتملة مكشوفة!${NC}"
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo ""
            echo -e "${YELLOW}يرجى:${NC}"
            echo -e "  1. إزالة الأسرار من الكود"
            echo -e "  2. استخدام flutter_secure_storage للبيانات الحساسة"
            echo -e "  3. استخدام متغيرات البيئة للمفاتيح"
            echo -e "  4. إضافة الملفات الحساسة إلى .gitignore"
            echo ""
            echo -e "${RED}❌ تم منع الـ push لحماية الأمان${NC}"
            exit 1
        else
            echo -e "${GREEN}✅ لم يتم اكتشاف أسرار مكشوفة${NC}"
        fi
    fi
    
    echo ""
fi

# ===== النتيجة النهائية =====
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ Pre-push Hook اكتمل بنجاح!${NC}"
echo -e "${GREEN}⏱️  الوقت المستغرق: ${DURATION} ثانية${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0
