#!/bin/bash
# Pre-commit Hook - Error Tracking System
# المشروع: بصير MVP
# المؤلف: فريق وكلاء تطوير مشروع بصير
# التاريخ: 3 ديسمبر 2025

set -e

# الألوان للإخراج
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# قراءة التكوين
CONFIG_FILE=".kiro/config/error_tracking.yml"
ENABLED=$(grep -A 3 "pre_commit:" "$CONFIG_FILE" | grep "enabled:" | awk '{print $2}')
AUTO_FORMAT=$(grep -A 3 "pre_commit:" "$CONFIG_FILE" | grep "auto_format:" | awk '{print $2}')
BLOCK_ON_ERRORS=$(grep -A 3 "pre_commit:" "$CONFIG_FILE" | grep "block_on_errors:" | awk '{print $2}')

# التحقق من تفعيل الـ hook
if [ "$ENABLED" != "true" ]; then
    echo -e "${YELLOW}⚠️  Pre-commit hook معطل في التكوين${NC}"
    exit 0
fi

echo -e "${GREEN}🔍 تشغيل Pre-commit Hook...${NC}"
echo ""

# ===== 1. فحص التنسيق (Flutter Format) =====
echo -e "${GREEN}📝 فحص تنسيق الكود...${NC}"

# الحصول على ملفات Dart المعدلة
DART_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)

if [ -n "$DART_FILES" ]; then
    # فحص التنسيق
    if ! flutter format --set-exit-if-changed $DART_FILES > /dev/null 2>&1; then
        if [ "$AUTO_FORMAT" = "true" ]; then
            echo -e "${YELLOW}⚠️  الكود غير منسق. جاري التنسيق التلقائي...${NC}"
            flutter format $DART_FILES
            
            # إضافة الملفات المنسقة إلى staging
            git add $DART_FILES
            
            echo -e "${GREEN}✅ تم تنسيق الكود تلقائياً${NC}"
        else
            echo -e "${RED}❌ الكود غير منسق. يرجى تشغيل: flutter format .${NC}"
            exit 1
        fi
    else
        echo -e "${GREEN}✅ التنسيق صحيح${NC}"
    fi
else
    echo -e "${YELLOW}ℹ️  لا توجد ملفات Dart معدلة${NC}"
fi

echo ""

# ===== 2. التحليل الثابت (Flutter Analyze) =====
echo -e "${GREEN}🔬 تشغيل التحليل الثابت...${NC}"

# تشغيل flutter analyze
ANALYZE_OUTPUT=$(flutter analyze --no-pub 2>&1)
ANALYZE_EXIT_CODE=$?

if [ $ANALYZE_EXIT_CODE -ne 0 ]; then
    # حفظ نتائج التحليل في سجل
    TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
    LOG_FILE="logs/flutter_analyze_${TIMESTAMP}.log"
    echo "$ANALYZE_OUTPUT" > "$LOG_FILE"
    
    # عد الأخطاء والتحذيرات
    ERROR_COUNT=$(echo "$ANALYZE_OUTPUT" | grep -c "error •" || true)
    WARNING_COUNT=$(echo "$ANALYZE_OUTPUT" | grep -c "warning •" || true)
    
    echo -e "${RED}❌ تم اكتشاف مشاكل في التحليل:${NC}"
    echo -e "   ${RED}• أخطاء: $ERROR_COUNT${NC}"
    echo -e "   ${YELLOW}• تحذيرات: $WARNING_COUNT${NC}"
    echo ""
    echo -e "${YELLOW}📄 تم حفظ التفاصيل في: $LOG_FILE${NC}"
    echo ""
    
    # عرض أول 10 أخطاء
    echo -e "${RED}الأخطاء الأولى:${NC}"
    echo "$ANALYZE_OUTPUT" | grep "error •" | head -10
    echo ""
    
    if [ "$BLOCK_ON_ERRORS" = "true" ] && [ $ERROR_COUNT -gt 0 ]; then
        echo -e "${RED}❌ يرجى إصلاح الأخطاء قبل الـ commit${NC}"
        exit 1
    fi
else
    echo -e "${GREEN}✅ لا توجد مشاكل في التحليل${NC}"
fi

echo ""

# ===== 3. التحقق من رسالة الـ commit =====
echo -e "${GREEN}📋 التحقق من رسالة الـ commit...${NC}"

# قراءة رسالة الـ commit من ملف مؤقت إذا كانت موجودة
# ملاحظة: هذا الفحص سيتم في prepare-commit-msg hook
# هنا نقوم فقط بالتحذير

echo -e "${YELLOW}ℹ️  تذكير: استخدم صيغة Conventional Commits${NC}"
echo -e "${YELLOW}   مثال: feat(auth): add login functionality${NC}"
echo ""

# ===== النتيجة النهائية =====
echo -e "${GREEN}✅ Pre-commit Hook اكتمل بنجاح!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0
