#!/bin/bash
# Bash Aliases لمشروع بصير MVP
# المؤلف: فريق وكلاء تطوير مشروع بصير
# التاريخ: 1 ديسمبر 2025
#
# للاستخدام: أضف هذا السطر إلى ~/.bashrc
# source /path/to/Basir_MVP/.bash_aliases_basir

# ═══════════════════════════════════════════════════════════
# Git Aliases - للسرعة والإنتاجية
# ═══════════════════════════════════════════════════════════

# الأوامر الأساسية
alias gs='git status'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit'
alias gcm='git commit -m'
alias gp='git push'
alias gl='git pull'
alias gf='git fetch'

# الفروع
alias gb='git branch'
alias gba='git branch -a'
alias gbd='git branch -d'
alias gco='git checkout'
alias gcb='git checkout -b'

# السجل والتاريخ
alias glog='git log --oneline --graph --decorate'
alias gloga='git log --oneline --graph --decorate --all'
alias glogp='git log --pretty=format:"%h - %an, %ar : %s"'

# الفروقات
alias gd='git diff'
alias gds='git diff --staged'
alias gdh='git diff HEAD'

# التراجع والإصلاح
alias gundo='git reset HEAD~1'
alias gamend='git commit --amend'
alias gclean='git clean -fd'

# المعلومات
alias gremote='git remote -v'
alias gtags='git tag -l'
alias gstash='git stash'
alias gpop='git stash pop'

# ═══════════════════════════════════════════════════════════
# Flutter Aliases - للتطوير السريع
# ═══════════════════════════════════════════════════════════

# الأوامر الأساسية
alias fl='flutter'
alias flr='flutter run'
alias flrd='flutter run --debug'
alias flrr='flutter run --release'
alias flb='flutter build'

# التنظيف والصيانة
alias flc='flutter clean'
alias flpg='flutter pub get'
alias flpu='flutter pub upgrade'
alias flpr='flutter pub run'
alias flclean='flutter clean && flutter pub get'

# التحليل والاختبار
alias fla='flutter analyze'
alias flan='flutter analyze --no-pub'
alias flt='flutter test'
alias fltc='flutter test --coverage'
alias fltv='flutter test --verbose'

# البناء
alias flba='flutter build apk'
alias flbad='flutter build apk --debug'
alias flbar='flutter build apk --release'
alias flbab='flutter build appbundle'

# الأدوات
alias fld='flutter doctor'
alias fldv='flutter doctor -v'
alias fldev='flutter devices'
alias flup='flutter upgrade'

# ═══════════════════════════════════════════════════════════
# Basir Project Aliases - خاص بالمشروع
# ═══════════════════════════════════════════════════════════

# الاختبارات
alias btest='flutter test --coverage'
alias btestv='flutter test --coverage --verbose'
alias btestu='flutter test test/unit/'
alias btestw='flutter test test/widget/'

# التحليل
alias banalyze='flutter analyze --no-pub'
alias bcheck='flutter analyze --no-pub && flutter test'

# التنظيف الشامل
alias bclean='flutter clean && flutter pub get && flutter pub run build_runner build --delete-conflicting-outputs'

# البناء
alias bbuild='flutter build apk --debug'
alias brelease='flutter build apk --release'

# التحسين
alias boptimize='./optimize_environment.sh'

# التوثيق
alias bdoc='dart doc .'

# ═══════════════════════════════════════════════════════════
# Dart Aliases
# ═══════════════════════════════════════════════════════════

alias dr='dart run'
alias df='dart format'
alias dfa='dart format lib/ test/'
alias dfix='dart fix --apply'

# ═══════════════════════════════════════════════════════════
# System Aliases - أدوات النظام
# ═══════════════════════════════════════════════════════════

# التنقل السريع
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# القوائم
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'

# البحث
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# الأمان
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ═══════════════════════════════════════════════════════════
# Development Aliases - أدوات التطوير
# ═══════════════════════════════════════════════════════════

# VS Code
alias code='code .'
alias codew='code --wait'

# Git Flow
alias gstart='git checkout -b'
alias gfinish='git checkout main && git merge'

# Quick commits
alias gwip='git add -A && git commit -m "WIP"'
alias gsave='git add -A && git commit -m "SAVE"'

# ═══════════════════════════════════════════════════════════
# Performance Monitoring - مراقبة الأداء
# ═══════════════════════════════════════════════════════════

# قياس الوقت
alias timegit='time git'
alias timefl='time flutter'

# معلومات النظام
alias diskspace='df -h'
alias meminfo='free -h'
alias cpuinfo='lscpu'

# حجم المجلدات
alias dirsize='du -sh'
alias gitsize='du -sh .git'

# ═══════════════════════════════════════════════════════════
# Helper Functions - دوال مساعدة
# ═══════════════════════════════════════════════════════════

# دالة لإنشاء commit سريع
function gquick() {
    if [ -z "$1" ]; then
        echo "الاستخدام: gquick 'رسالة الـ commit'"
        return 1
    fi
    git add --all
    git commit -m "$1"
    git push
}

# دالة لإنشاء فرع جديد والانتقال إليه
function gnew() {
    if [ -z "$1" ]; then
        echo "الاستخدام: gnew اسم-الفرع"
        return 1
    fi
    git checkout -b "$1"
}

# دالة لتشغيل الاختبارات لملف محدد
function btest-file() {
    if [ -z "$1" ]; then
        echo "الاستخدام: btest-file path/to/test_file.dart"
        return 1
    fi
    flutter test "$1"
}

# دالة لعرض حالة المشروع
function bstatus() {
    echo "📊 حالة مشروع بصير MVP"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "📦 Git:"
    git status -sb
    echo ""
    echo "📱 Flutter:"
    flutter --version | head -1
    echo ""
    echo "💾 حجم المشروع:"
    du -sh .
    echo ""
    echo "🗂️  حجم .git:"
    du -sh .git
    echo ""
    echo "💿 المساحة المتاحة:"
    df -h . | tail -1 | awk '{print $4}'
}

# دالة للتنظيف الشامل
function bfullclean() {
    echo "🧹 بدء التنظيف الشامل..."
    flutter clean
    rm -rf .dart_tool
    rm -rf build
    rm -rf .flutter-plugins
    rm -rf .flutter-plugins-dependencies
    flutter pub get
    echo "✅ تم التنظيف بنجاح!"
}

# دالة لتشغيل جميع الاختبارات مع التقرير
function btest-all() {
    echo "🧪 تشغيل جميع الاختبارات..."
    flutter test --coverage
    echo ""
    echo "📊 تغطية الاختبارات:"
    if command -v lcov &> /dev/null; then
        lcov --summary coverage/lcov.info 2>/dev/null || echo "تثبيت lcov للحصول على تقرير التغطية"
    else
        echo "تثبيت lcov للحصول على تقرير التغطية: sudo apt-get install lcov"
    fi
}

# ═══════════════════════════════════════════════════════════
# Welcome Message - رسالة الترحيب
# ═══════════════════════════════════════════════════════════

echo "✅ تم تحميل Basir App aliases بنجاح!"
echo "💡 استخدم 'bstatus' لعرض حالة المشروع"
echo "💡 استخدم 'btest' لتشغيل الاختبارات"
echo "💡 استخدم 'banalyze' لتحليل الكود"
