#!/bin/bash

# Git Hook: pre-push
# يتحقق من جودة الكود قبل الـ push

set -e

# الألوان
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}=== Pre-push Hook ===${NC}"
echo ""

# 1. التحقق من الفرع
CURRENT_BRANCH=$(git branch --show-current)
echo -e "${YELLOW}[1/5]${NC} الفرع الحالي: $CURRENT_BRANCH"

if [ "$CURRENT_BRANCH" == "main" ] || [ "$CURRENT_BRANCH" == "master" ]; then
    echo -e "${RED}[WARNING]${NC} أنت على فرع $CURRENT_BRANCH!"
    echo -e "${YELLOW}[INFO]${NC} هل أنت متأكد من الـ push مباشرة؟ (y/N)"
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo -e "${RED}[BLOCKED]${NC} تم إلغاء الـ push"
        exit 1
    fi
fi

# 2. تشغيل Flutter Analyze
echo -e "${YELLOW}[2/5]${NC} تشغيل Flutter Analyze..."
ANALYZE_OUTPUT=$(flutter analyze 2>&1)
ERROR_COUNT=$(echo "$ANALYZE_OUTPUT" | grep -c "error •" || echo "0")

if [ "$ERROR_COUNT" -gt "0" ]; then
    echo -e "${RED}[ERROR]${NC} يوجد $ERROR_COUNT أخطاء في الكود"
    echo "$ANALYZE_OUTPUT" | grep "error •" | head -10
    echo ""
    echo -e "${RED}[BLOCKED]${NC} يرجى إصلاح الأخطاء قبل الـ push"
    exit 1
fi
echo -e "${GREEN}[SUCCESS]${NC} لا توجد أخطاء حرجة"

# 3. تشغيل الاختبارات
echo -e "${YELLOW}[3/5]${NC} تشغيل الاختبارات..."
if ! flutter test --no-pub > /tmp/test_output.txt 2>&1; then
    echo -e "${RED}[ERROR]${NC} بعض الاختبارات فشلت"
    cat /tmp/test_output.txt | tail -20
    echo ""
    echo -e "${RED}[BLOCKED]${NC} يرجى إصلاح الاختبارات الفاشلة"
    exit 1
fi
echo -e "${GREEN}[SUCCESS]${NC} جميع الاختبارات نجحت"

# 4. التحقق من الأسرار
echo -e "${YELLOW}[4/5]${NC} التحقق من الأسرار..."
SECRETS_FOUND=0

# البحث عن أنماط شائعة للأسرار
PATTERNS=(
    "password\s*=\s*['\"][^'\"]+['\"]"
    "api[_-]?key\s*=\s*['\"][^'\"]+['\"]"
    "secret\s*=\s*['\"][^'\"]+['\"]"
    "token\s*=\s*['\"][^'\"]+['\"]"
    "aws[_-]?access[_-]?key"
    "private[_-]?key"
)

for pattern in "${PATTERNS[@]}"; do
    if git diff --cached | grep -iE "$pattern" > /dev/null; then
        echo -e "${RED}[WARNING]${NC} تم اكتشاف نمط مشبوه: $pattern"
        SECRETS_FOUND=$((SECRETS_FOUND + 1))
    fi
done

if [ $SECRETS_FOUND -gt 0 ]; then
    echo -e "${RED}[WARNING]${NC} تم اكتشاف $SECRETS_FOUND نمط مشبوه للأسرار"
    echo -e "${YELLOW}[INFO]${NC} هل أنت متأكد من المتابعة؟ (y/N)"
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo -e "${RED}[BLOCKED]${NC} تم إلغاء الـ push"
        exit 1
    fi
fi
echo -e "${GREEN}[SUCCESS]${NC} لا توجد أسرار مكشوفة"

# 5. التحقق من حجم الملفات
echo -e "${YELLOW}[5/5]${NC} التحقق من حجم الملفات..."
LARGE_FILES=$(git diff --cached --name-only | xargs -I {} du -h {} 2>/dev/null | awk '$1 ~ /M$/ && $1+0 > 10')

if [ ! -z "$LARGE_FILES" ]; then
    echo -e "${YELLOW}[WARNING]${NC} يوجد ملفات كبيرة (> 10MB):"
    echo "$LARGE_FILES"
    echo ""
    echo -e "${YELLOW}[INFO]${NC} يُفضل استخدام Git LFS للملفات الكبيرة"
    echo -e "${YELLOW}[INFO]${NC} هل تريد المتابعة؟ (y/N)"
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo -e "${RED}[BLOCKED]${NC} تم إلغاء الـ push"
        exit 1
    fi
fi

echo ""
echo -e "${GREEN}[SUCCESS]${NC} جميع الفحوصات نجحت!"
echo -e "${GREEN}[INFO]${NC} يمكنك المتابعة مع الـ push"
echo ""

exit 0
