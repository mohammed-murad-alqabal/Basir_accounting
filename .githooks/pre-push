#!/bin/bash

# Pre-push hook for Basir ERP Development
# Validates branch naming conventions before pushing

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get current branch name
current_branch=$(git rev-parse --abbrev-ref HEAD)

echo -e "${YELLOW}🔍 Validating branch name: $current_branch${NC}"

# Define valid branch name patterns for ERP development
valid_patterns=(
    "^main$"
    "^development$"
    "^feature/hr-[a-z0-9-]+$"
    "^feature/payroll-[a-z0-9-]+$"
    "^feature/inventory-[a-z0-9-]+$"
    "^feature/accounting-[a-z0-9-]+$"
    "^feature/invoices-[a-z0-9-]+$"
    "^feature/customers-[a-z0-9-]+$"
    "^feature/vendors-[a-z0-9-]+$"
    "^feature/reports-[a-z0-9-]+$"
    "^feature/erp-[a-z0-9-]+$"
    "^feature/zatca-[a-z0-9-]+$"
    "^feature/tax-[a-z0-9-]+$"
    "^feature/ui-[a-z0-9-]+$"
    "^feature/core-[a-z0-9-]+$"
    "^feature/security-[a-z0-9-]+$"
    "^feature/performance-[a-z0-9-]+$"
    "^feature/localization-[a-z0-9-]+$"
    "^bugfix/[a-z0-9-]+$"
    "^hotfix/[a-z0-9-]+$"
    "^release/v[0-9]+\.[0-9]+\.[0-9]+$"
    "^release/v[0-9]+\.[0-9]+\.[0-9]+-[a-z0-9-]+$"
    "^backup/[a-z0-9-]+$"
    "^experiment/[a-z0-9-]+$"
    "^refactor/[a-z0-9-]+$"
    "^docs/[a-z0-9-]+$"
    "^chore/[a-z0-9-]+$"
)

# Check if branch name matches any valid pattern
is_valid=false
for pattern in "${valid_patterns[@]}"; do
    if [[ $current_branch =~ $pattern ]]; then
        is_valid=true
        break
    fi
done

if [ "$is_valid" = true ]; then
    echo -e "${GREEN}✅ Branch name '$current_branch' is valid${NC}"
    
    # Additional checks for feature branches
    if [[ $current_branch =~ ^feature/ ]]; then
        echo -e "${YELLOW}📋 Feature branch detected. Checking additional requirements...${NC}"
        
        # Check if branch has proper description
        if [[ ${#current_branch} -lt 15 ]]; then
            echo -e "${YELLOW}⚠️  Branch name is quite short. Consider adding more descriptive information.${NC}"
        fi
        
        # Check for common ERP modules
        if [[ $current_branch =~ (hr|payroll|inventory|accounting|invoices|customers|vendors|reports) ]]; then
            echo -e "${GREEN}✅ ERP module detected in branch name${NC}"
        fi
    fi
    
    # Check for release branches
    if [[ $current_branch =~ ^release/ ]]; then
        echo -e "${YELLOW}🚀 Release branch detected. Ensure proper versioning.${NC}"
    fi
    
    # Check for hotfix branches
    if [[ $current_branch =~ ^hotfix/ ]]; then
        echo -e "${RED}🚨 Hotfix branch detected. Ensure critical issue documentation.${NC}"
    fi
    
    exit 0
else
    echo -e "${RED}❌ Invalid branch name: '$current_branch'${NC}"
    echo -e "${RED}Branch name must follow ERP development conventions:${NC}"
    echo ""
    echo -e "${YELLOW}Valid patterns:${NC}"
    echo "  • feature/hr-<description>        - HR management features"
    echo "  • feature/payroll-<description>   - Payroll system features"
    echo "  • feature/inventory-<description> - Inventory management features"
    echo "  • feature/accounting-<description>- Accounting system features"
    echo "  • feature/invoices-<description>  - Invoice management features"
    echo "  • feature/customers-<description> - Customer management features"
    echo "  • feature/vendors-<description>   - Vendor management features"
    echo "  • feature/reports-<description>   - Reporting system features"
    echo "  • feature/erp-<description>       - General ERP features"
    echo "  • feature/zatca-<description>     - ZATCA compliance features"
    echo "  • feature/tax-<description>       - Tax management features"
    echo "  • feature/ui-<description>        - UI/UX improvements"
    echo "  • feature/core-<description>      - Core system features"
    echo "  • feature/security-<description>  - Security enhancements"
    echo "  • bugfix/<description>            - Bug fixes"
    echo "  • hotfix/<description>            - Critical fixes"
    echo "  • release/v<major>.<minor>.<patch>- Release branches"
    echo "  • docs/<description>              - Documentation updates"
    echo "  • chore/<description>             - Maintenance tasks"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  • feature/hr-employee-management"
    echo "  • feature/payroll-salary-calculation"
    echo "  • feature/accounting-journal-entries"
    echo "  • bugfix/invoice-tax-calculation"
    echo "  • hotfix/zatca-compliance-error"
    echo "  • release/v1.2.0"
    echo ""
    echo -e "${RED}Please rename your branch and try again.${NC}"
    echo -e "${YELLOW}To rename: git branch -m $current_branch <new-name>${NC}"
    
    exit 1
fi