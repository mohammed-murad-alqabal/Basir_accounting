#!/bin/bash
# Pre-commit hook: File Organization Check
# Prevents adding unwanted files to project root
# Part of Basir MVP file organization standards

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}🔍 التحقق من تنظيم الملفات...${NC}"

# Check for unwanted files in root
UNWANTED_PATTERNS=(
  '^\w+\.log$'
  '^\w+\.tmp$'
  '^\w+\.temp$'
  '^\w+\.bak$'
  '^\w+\.db$'
  '^\w+\.so$'
  '^\w+\.dll$'
  '^\w+\.dylib$'
  '^[A-Z_]+_REPORT\.md$'
  '^[A-Z_]+_STATUS\.md$'
  '^[A-Z_]+_SUMMARY\.md$'
  '^[A-Z_]+_GUIDE\.md$'
  '^[A-Z_]+_ANALYSIS\.md$'
  '^CHECKPOINT_.*\.md$'
  '^CONTINUATION_.*\.md$'
  '^IMMEDIATE_.*\.md$'
)

# Get staged files in root
STAGED_ROOT_FILES=$(git diff --cached --name-only --diff-filter=A | grep -E '^[^/]+\.(log|tmp|temp|bak|db|so|dll|dylib|md)$')

if [ -z "$STAGED_ROOT_FILES" ]; then
  echo -e "${GREEN}✅ لا توجد ملفات غير مرغوبة${NC}"
  exit 0
fi

# Check each file
VIOLATIONS=()
while IFS= read -r file; do
  if [ -z "$file" ]; then
    continue
  fi
  
  # Check against patterns
  for pattern in "${UNWANTED_PATTERNS[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      VIOLATIONS+=("$file")
      break
    fi
  done
done <<< "$STAGED_ROOT_FILES"

# If violations found, show error and exit
if [ ${#VIOLATIONS[@]} -gt 0 ]; then
  echo -e "${RED}❌ خطأ: محاولة إضافة ملفات غير مرغوبة في الجذر!${NC}"
  echo ""
  echo -e "${YELLOW}الملفات المرفوضة:${NC}"
  for file in "${VIOLATIONS[@]}"; do
    echo -e "  ${RED}✗${NC} $file"
  done
  echo ""
  echo -e "${YELLOW}الرجاء نقل هذه الملفات إلى المجلدات المناسبة:${NC}"
  echo ""
  echo -e "  ${GREEN}*.log${NC}     → logs/"
  echo -e "  ${GREEN}*.tmp${NC}     → /tmp/"
  echo -e "  ${GREEN}*.bak${NC}     → backups/"
  echo -e "  ${GREEN}*.db${NC}      → .kiro/data/"
  echo -e "  ${GREEN}*.so/dll${NC}  → (مُولدة تلقائياً، أضفها لـ .gitignore)"
  echo -e "  ${GREEN}*_REPORT.md${NC} → docs/reports/ أو .kiro/docs/reports/"
  echo ""
  echo -e "${YELLOW}للمزيد من المعلومات:${NC}"
  echo -e "  cat .kiro/standards/file-organization.md"
  echo ""
  exit 1
fi

echo -e "${GREEN}✅ جميع الملفات في أماكنها الصحيحة${NC}"
exit 0
