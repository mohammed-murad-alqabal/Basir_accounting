#!/bin/bash

# Pre-Commit Automation Hook
# نظام الأتمتة الذكية للمستودع
# المشروع: بصير MVP

set -e

echo "🤖 [Automation] بدء الفحص التلقائي..."

# الألوان
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# المتغيرات
ROOT_DIR=$(git rev-parse --show-toplevel)
MAX_ROOT_FILES=10
MAX_FILE_SIZE=$((10 * 1024 * 1024)) # 10 MB
AUTO_FIX=true
BACKUP_DIR="$ROOT_DIR/.git/automation-backups"

# إنشاء مجلد النسخ الاحتياطية
mkdir -p "$BACKUP_DIR"

# ====================
# 1. فحص الملفات المضافة
# ====================
echo -e "${BLUE}[1/6]${NC} فحص الملفات المضافة..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
ISSUES_FOUND=0
AUTO_FIXED=0

for file in $STAGED_FILES; do
    # تخطي الملفات المحذوفة
    [ ! -f "$file" ] && continue
    
    # فحص حجم الملف
    FILE_SIZE=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
    if [ "$FILE_SIZE" -gt "$MAX_FILE_SIZE" ]; then
        echo -e "${RED}✗${NC} ملف كبير جداً: $file ($(numfmt --to=iec-i --suffix=B $FILE_SIZE))"
        echo "  💡 استخدم Git LFS للملفات الكبيرة"
        ISSUES_FOUND=$((ISSUES_FOUND + 1))
    fi
    
    # فحص الملفات المؤقتة
    if [[ "$file" =~ ^test_.*\.(txt|json|log)$ ]] || [[ "$file" =~ test_archive ]]; then
        echo -e "${YELLOW}⚠${NC} ملف مؤقت: $file"
        if [ "$AUTO_FIX" = true ]; then
            # إضافة إلى .gitignore
            echo "$file" >> .gitignore
            git reset HEAD "$file" 2>/dev/null || true
            echo -e "${GREEN}✓${NC} تم إزالة الملف من staging وإضافته إلى .gitignore"
            AUTO_FIXED=$((AUTO_FIXED + 1))
        fi
    fi
    
    # فحص موقع التقارير
    if [[ "$file" =~ ^[A-Z_]+_REPORT\.md$ ]] && [[ ! "$file" =~ ^docs/ ]]; then
        echo -e "${YELLOW}⚠${NC} تقرير في مكان خاطئ: $file"
        if [ "$AUTO_FIX" = true ]; then
            # تحديد المجلد المناسب
            TARGET_DIR="docs/reports/fixes"
            if [[ "$file" =~ PERFORMANCE ]]; then
                TARGET_DIR="docs/reports/performance"
            elif [[ "$file" =~ TEST ]]; then
                TARGET_DIR="docs/reports/testing"
            elif [[ "$file" =~ BUILD ]]; then
                TARGET_DIR="docs/reports/builds"
            elif [[ "$file" =~ SESSION ]]; then
                TARGET_DIR="docs/sessions"
            fi
            
            # نقل الملف
            mkdir -p "$TARGET_DIR"
            git mv "$file" "$TARGET_DIR/" 2>/dev/null || mv "$file" "$TARGET_DIR/"
            git add "$TARGET_DIR/$(basename $file)"
            echo -e "${GREEN}✓${NC} تم نقل التقرير إلى $TARGET_DIR/"
            AUTO_FIXED=$((AUTO_FIXED + 1))
        fi
    fi
done

# ====================
# 2. فحص عدد الملفات في الجذر
# ====================
echo -e "${BLUE}[2/6]${NC} فحص تنظيم الجذر..."

ROOT_MD_COUNT=$(ls -1 *.md 2>/dev/null | wc -l | tr -d ' ')
if [ "$ROOT_MD_COUNT" -gt "$MAX_ROOT_FILES" ]; then
    echo -e "${YELLOW}⚠${NC} عدد ملفات .md في الجذر: $ROOT_MD_COUNT (الحد الأقصى: $MAX_ROOT_FILES)"
    ISSUES_FOUND=$((ISSUES_FOUND + 1))
fi

# ====================
# 3. فحص البيانات الحساسة
# ====================
echo -e "${BLUE}[3/6]${NC} فحص البيانات الحساسة..."

SENSITIVE_PATTERNS=(
    "password.*=.*['\"].*['\"]"
    "api[_-]?key.*=.*['\"].*['\"]"
    "secret.*=.*['\"].*['\"]"
    "token.*=.*['\"].*['\"]"
    "aws[_-]?access[_-]?key"
    "private[_-]?key"
)

for file in $STAGED_FILES; do
    [ ! -f "$file" ] && continue
    
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        if grep -iE "$pattern" "$file" >/dev/null 2>&1; then
            echo -e "${RED}✗${NC} بيانات حساسة محتملة في: $file"
            echo "  🔒 يرجى مراجعة الملف وإزالة البيانات الحساسة"
            ISSUES_FOUND=$((ISSUES_FOUND + 1))
            break
        fi
    done
done

# ====================
# 4. فحص جودة الكود (Flutter)
# ====================
echo -e "${BLUE}[4/6]${NC} فحص جودة الكود..."

DART_FILES=$(echo "$STAGED_FILES" | grep "\.dart$" || true)
if [ -n "$DART_FILES" ]; then
    if command -v flutter &> /dev/null; then
        if ! flutter analyze --no-pub 2>&1 | grep -q "No issues found"; then
            echo -e "${YELLOW}⚠${NC} توجد مشاكل في flutter analyze"
            echo "  💡 قم بتشغيل: flutter analyze"
        fi
    fi
fi

# ====================
# 5. تحديث CHANGELOG تلقائياً
# ====================
echo -e "${BLUE}[5/6]${NC} التحقق من CHANGELOG..."

if [ -n "$STAGED_FILES" ]; then
    # التحقق من وجود تحديث في CHANGELOG
    if ! echo "$STAGED_FILES" | grep -q "CHANGELOG.md"; then
        echo -e "${YELLOW}ℹ${NC} لم يتم تحديث CHANGELOG.md"
        echo "  💡 فكر في توثيق التغييرات في CHANGELOG"
    fi
fi

# ====================
# 6. إنشاء نسخة احتياطية
# ====================
echo -e "${BLUE}[6/6]${NC} إنشاء نسخة احتياطية..."

BACKUP_FILE="$BACKUP_DIR/backup-$(date +%Y%m%d-%H%M%S).tar.gz"
if [ -n "$STAGED_FILES" ]; then
    tar -czf "$BACKUP_FILE" $STAGED_FILES 2>/dev/null || true
    echo -e "${GREEN}✓${NC} تم إنشاء نسخة احتياطية: $(basename $BACKUP_FILE)"
fi

# ====================
# النتيجة النهائية
# ====================
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${GREEN}✓${NC} الفحص التلقائي مكتمل"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📊 الإحصائيات:"
echo "  • المشاكل المكتشفة: $ISSUES_FOUND"
echo "  • الإصلاحات التلقائية: $AUTO_FIXED"
echo "  • الملفات المفحوصة: $(echo "$STAGED_FILES" | wc -l | tr -d ' ')"
echo ""

# السماح بالمتابعة حتى مع وجود مشاكل (تحذيرات فقط)
if [ "$ISSUES_FOUND" -gt 0 ]; then
    echo -e "${YELLOW}⚠${NC} توجد $ISSUES_FOUND مشكلة تحتاج مراجعة"
    echo "  💡 يمكنك المتابعة، لكن يُنصح بمراجعة المشاكل"
fi

exit 0
