#!/bin/bash

# Enhanced Pre-Commit Hook v2.0
# Implements: COLLABORATION FIRST, KISS, Security First, Quality First, ENGLISH FOR CODE
# Project: Basir App
# Author: Basir Development Agents Team
# Date: December 8, 2025

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored message
print_message() {
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

# Print section header
print_header() {
    echo ""
    print_message "$BLUE" "=================================================="
    print_message "$BLUE" "$1"
    print_message "$BLUE" "=================================================="
    echo ""
}

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Main execution
main() {
    print_header "🔍 Pre-Commit Hook v2.0"
    
    print_message "$BLUE" "Running pre-commit checks..."
    echo ""
    
    # 1. Check for Flutter
    if ! command_exists flutter; then
        print_message "$RED" "❌ Flutter not found"
        exit 1
    fi
    
    # 2. Format check
    print_header "📝 Code Formatting"
    print_message "$BLUE" "Checking code formatting..."
    
    if ! dart format --set-exit-if-changed . >/dev/null 2>&1; then
        print_message "$YELLOW" "⚠️  Code formatting issues found. Auto-formatting..."
        dart format .
        print_message "$GREEN" "✅ Code formatted. Please review and commit again."
        exit 1
    fi
    print_message "$GREEN" "✅ Code formatting OK"
    
    # 3. Static analysis
    print_header "🔍 Static Analysis"
    print_message "$BLUE" "Running flutter analyze..."
    
    if ! flutter analyze --no-fatal-infos; then
        print_message "$RED" "❌ Static analysis failed"
        print_message "$YELLOW" "💡 Fix the issues above and try again"
        exit 1
    fi
    print_message "$GREEN" "✅ Static analysis passed"
    
    # 4. Check for hardcoded secrets (Security First)
    print_header "🔒 Security Checks"
    print_message "$BLUE" "Checking for hardcoded secrets..."
    
    # Get staged files
    staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(dart|yaml|json)$' || true)
    
    if [ -n "$staged_files" ]; then
        # Check for common secret patterns
        secret_patterns=(
            "password\s*=\s*['\"][^'\"]+['\"]"
            "api[_-]?key\s*=\s*['\"][^'\"]+['\"]"
            "secret\s*=\s*['\"][^'\"]+['\"]"
            "token\s*=\s*['\"][^'\"]+['\"]"
            "sk_live_"
            "sk_test_"
        )
        
        found_secrets=false
        for pattern in "${secret_patterns[@]}"; do
            if echo "$staged_files" | xargs grep -iE "$pattern" 2>/dev/null; then
                found_secrets=true
                break
            fi
        done
        
        if [ "$found_secrets" = true ]; then
            print_message "$RED" "❌ Potential hardcoded secrets found!"
            print_message "$YELLOW" "💡 Use environment variables or secure storage instead"
            exit 1
        fi
    fi
    print_message "$GREEN" "✅ No hardcoded secrets found"
    
    # 5. Check commit message format (COLLABORATION FIRST)
    print_header "📝 Commit Message"
    print_message "$BLUE" "Checking commit message format..."
    
    # Get commit message
    commit_msg_file=".git/COMMIT_EDITMSG"
    if [ -f "$commit_msg_file" ]; then
        commit_msg=$(head -n 1 "$commit_msg_file")
        
        # Check conventional commits format
        if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build)(\(.+\))?: .+"; then
            print_message "$YELLOW" "⚠️  Commit message doesn't follow Conventional Commits format"
            print_message "$YELLOW" "💡 Format: type(scope): description"
            print_message "$YELLOW" "💡 Example: feat(customers): add search functionality"
        else
            print_message "$GREEN" "✅ Commit message format OK"
        fi
    fi
    
    # 6. Check for ENGLISH FOR CODE principle
    print_header "🌍 Language Check"
    print_message "$BLUE" "Checking for English code..."
    
    if [ -n "$staged_files" ]; then
        # Check for non-English variable/function names (basic check)
        if echo "$staged_files" | xargs grep -E "[\u0600-\u06FF]" 2>/dev/null | grep -v "// " | grep -v "/// " | grep -v "String" | grep -v "Text(" >/dev/null; then
            print_message "$YELLOW" "⚠️  Non-English characters found in code (outside comments/strings)"
            print_message "$YELLOW" "💡 Use English for all code, variables, and function names"
        else
            print_message "$GREEN" "✅ Code language check passed"
        fi
    fi
    
    # 7. Check for KISS principle violations
    print_header "🎯 KISS Principle Check"
    print_message "$BLUE" "Checking for overly complex code..."
    
    if [ -n "$staged_files" ]; then
        # Check for very long functions (>100 lines)
        long_functions=$(echo "$staged_files" | xargs grep -n "^\s*\(void\|Future\|int\|String\|bool\|double\)" 2>/dev/null | \
            awk -F: '{print $1":"$2}' | \
            while read line; do
                file=$(echo "$line" | cut -d: -f1)
                start=$(echo "$line" | cut -d: -f2)
                # Simple heuristic: check if function is >100 lines
                end=$(tail -n +$start "$file" | grep -n "^\s*}" | head -1 | cut -d: -f1)
                if [ -n "$end" ] && [ $end -gt 100 ]; then
                    echo "$file:$start (${end} lines)"
                fi
            done)
        
        if [ -n "$long_functions" ]; then
            print_message "$YELLOW" "⚠️  Very long functions found (>100 lines):"
            echo "$long_functions"
            print_message "$YELLOW" "💡 Consider breaking down into smaller functions (KISS principle)"
        else
            print_message "$GREEN" "✅ No overly complex functions found"
        fi
    fi
    
    # Success
    print_header "✅ Pre-Commit Checks Passed!"
    
    print_message "$GREEN" "🎉 All checks passed!"
    print_message "$BLUE" "📝 Proceeding with commit..."
    
    echo ""
    print_message "$BLUE" "Principles Applied:"
    print_message "$GREEN" "- ✅ COLLABORATION FIRST: Clear feedback on issues"
    print_message "$GREEN" "- ✅ KISS: Simple, focused checks"
    print_message "$GREEN" "- ✅ Security First: Secret detection"
    print_message "$GREEN" "- ✅ Quality First: Format and analysis checks"
    print_message "$GREEN" "- ✅ ENGLISH FOR CODE: Language validation"
}

# Run main function
main "$@"
