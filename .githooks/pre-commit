#!/bin/bash

# Git Hook: Pre-commit
# يتم تشغيله قبل كل commit للتحقق من جودة الكود

set -e

# الألوان
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}=== Pre-commit Hook ===${NC}"
echo ""

# 1. تشغيل Dart Format
echo -e "${YELLOW}[1/4]${NC} تشغيل Dart Format..."
# تنسيق الملفات المعدلة فقط
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "\.dart$" || true)

if [ ! -z "$STAGED_DART_FILES" ]; then
    if ! dart format --set-exit-if-changed $STAGED_DART_FILES > /dev/null 2>&1; then
        echo -e "${YELLOW}[INFO]${NC} تنسيق الملفات المعدلة..."
        dart format $STAGED_DART_FILES
        git add $STAGED_DART_FILES
        echo -e "${GREEN}[SUCCESS]${NC} تم تنسيق الملفات وإضافتها"
    fi
fi
echo -e "${GREEN}[SUCCESS]${NC} الكود منسق بشكل صحيح"

# 2. تشغيل Flutter Analyze
echo -e "${YELLOW}[2/4]${NC} تشغيل Flutter Analyze..."
ANALYZE_OUTPUT=$(flutter analyze 2>&1)
ERROR_COUNT=$(echo "$ANALYZE_OUTPUT" | grep -c "error •" || echo "0")

if [ "$ERROR_COUNT" -gt "0" ]; then
    echo -e "${RED}[ERROR]${NC} يوجد $ERROR_COUNT أخطاء في الكود"
    echo "$ANALYZE_OUTPUT" | grep "error •" | head -10
    echo ""
    echo -e "${RED}[BLOCKED]${NC} يرجى إصلاح الأخطاء قبل الـ commit"
    exit 1
fi
echo -e "${GREEN}[SUCCESS]${NC} لا توجد أخطاء حرجة"

# 3. تشغيل الاختبارات السريعة (معطل مؤقتاً)
echo -e "${YELLOW}[3/4]${NC} تخطي الاختبارات (معطل مؤقتاً)..."
# if ! flutter test --no-pub > /dev/null 2>&1; then
#     echo -e "${RED}[ERROR]${NC} بعض الاختبارات فشلت"
#     echo -e "${YELLOW}[WARNING]${NC} يرجى التحقق من الاختبارات"
#     # لا نمنع الـ commit لكن نحذر
# fi
echo -e "${GREEN}[SUCCESS]${NC} تم التخطي"

# 4. التحقق من TODO Comments
echo -e "${YELLOW}[4/4]${NC} التحقق من TODO Comments..."
INVALID_TODOS=$(git diff --cached --name-only | grep "\.dart$" | xargs grep -n "// TODO:" 2>/dev/null || true)

if [ ! -z "$INVALID_TODOS" ]; then
    echo -e "${YELLOW}[WARNING]${NC} يوجد TODO comments بصيغة قديمة:"
    echo "$INVALID_TODOS"
    echo ""
    echo -e "${YELLOW}[INFO]${NC} الصيغة الصحيحة: // TODO(username): description - Issue #XXX"
fi

echo ""
echo -e "${GREEN}[SUCCESS]${NC} جميع الفحوصات نجحت!"
echo -e "${GREEN}[INFO]${NC} يمكنك المتابعة مع الـ commit"
echo ""

exit 0
